struct spfa{
    struct edge{int v,w;};
    int n;
    vector<vector<edge>> E;
    vector<int> dis,cnt,inq,pre;
    void init(int _n){
        n=_n+1;
        E.assign(n,{});
    }
    void add_edge(int u,int v,int w){
        E[u].push_back({v,w});
    }
    bool dist(int s){
        dis.assign(n,inf);
        cnt.assign(n,0);
        inq.assign(n,0);
        pre.assign(n,-1);
        queue<int> q;
        dis[s]=0;
        q.push(s);
        inq[s]=1;
        while(!q.empty()){
            int u=q.front();q.pop();
            inq[u]=0;
            for(auto [v,w]:E[u]){
                if(dis[u]!=inf && dis[u]+w<dis[v]){
                    dis[v]=dis[u]+w;
                    pre[v]=u;
                    cnt[v]=cnt[u]+1;
                    if(cnt[v]>=n-1) return 0;
                    if(!inq[v]){inq[v]=1;q.push(v);}
        }}}
        return 1;
    }
    vector<int> get_path(int s,int t){
        if(dis[t]==inf) return {};
        vector<int> res;
        for(int i=t;i!=-1;i=pre[i]) res.push_back(i);
        reverse(res.begin(),res.end());
        if(res[0]!=s) return {};
        return res;
}};