struct dijkstra{
    #define pii pair<int,int>
    int n,source;
    vector<vector<pii>> E;
    vector<int> pre,vis,dis;
    void init(int _n){
        n=_n+1;
        E.assign(n,{});
    }
    void add_edge(int u,int v,int w){
        E[u].push_back({v,w});
    }
    void dist(int s){
        source=s;
        pre.assign(n,-1);
        vis.assign(n,0);
        dis.assign(n,inf);
        priority_queue<pii,vector<pii>,greater<pii>> pq;
        dis[s]=0;
        pq.push({dis[s],s});
        while(!pq.empty()){
            int u=pq.top().second;pq.pop();
            if(vis[u]) continue;
            vis[u]=1;
            for(auto [v,w]:E[u]){
                if(dis[u]+w<dis[v]){
                    dis[v]=dis[u]+w;
                    pq.push({dis[v],v});
                    pre[v]=u;
    }}}}
    vector<int> get_path(int t){
        if(dis[t]==inf) return {};
        vector<int> res;
        for(int i=t;i!=-1;i=pre[i]) res.push_back(i);
        reverse(res.begin(),res.end());
        if(res.empty() || res[0]!=source) return {};
        return res;
}};