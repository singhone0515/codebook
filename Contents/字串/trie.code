struct trie{
    trie *nxt[26]={};
    int cnt=0;
    int sz=0;
};
trie *root=new trie();
void insert(const string &s){
    trie *now=root;
    for(auto i:s){
        if(now->nxt[i-'a']==NULL){
            now->nxt[i-'a']=new trie();
        }
        now=now->nxt[i-'a'];
}}
int qry(string &s){
    trie *now=root;
    for(auto i:s){
        if(now->nxt[i-'a']==NULL) return;
        now=now->nxt[i-'a'];
    }
    return now->cnt;
}