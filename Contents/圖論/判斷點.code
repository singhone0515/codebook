auto cross(Pt a,Pt b,Pt c){return (b-a)^(c-a);}
auto dot(Pt a,Pt b,Pt c){return (b-a)*(c-a);}
double dis(Pt p){return sqrt(p*p);}
struct Line{Pt a,b;};
bool PtOnSeg(Pt p,Line l){ //判斷在線段上
    return sgn(cross(l.a,l.b,p))==0 && 
           sgn(dot(p,l.a,l.b))<=0;
}
double PtSegDist(Pt p,Line l){//求點線距
    double ans=min(abs(p-l.a),abs(p-l.b));
    if(sgn(dot(l.a,l.b,p))<0) return ans;
    if(sgn(dot(l.b,l.a,p))<0) return ans;
    return min(ans,
            abs(cross(p,l.a,l.b))/abs(l.a-l.b));
}
int PtSide(Pt p,Line l){
    return sgn(cross(l.a,l.b,p));
}
bool isInter(Line l1,Line l2){ //線段相交
    if(PtOnSeg(l2.a,l1) || PtOnSeg(l2.b,l1) ||
       PtOnSeg(l1.a,l2) || PtOnSeg(l1.b,l2)) 
       return 1;
    return PtSide(l2.a,l1)*PtSide(l2.b,l1)<0 &&
           PtSide(l1.a,l2)*PtSide(l1.b,l2)<0;
}
int inPoly(Pt p,vector<Pt> &vec){//在多邊形中
    int n=vec.size();
    int cnt=0;

    for(int i=0;i<n;i++){
        Pt a=vec[i];
        Pt b=vec[(i+1)%n];

        if(PtOnSeg(p,{a,b})) return 1;

        if((sgn(a.y-p.y)==1)^(sgn(b.y-p.y)==1)){
            cnt+=sgn(cross(a,b,p));
        }
    }

    return (cnt==0)?0:2;
}//(0,1,2)->(外,線,內)