struct Segtree{ // 0-base
    int n;
    vector<int> seg;
    vector<int> tag;
    vector<int> *a;
    #define cl(x) (x<<1)+1
    #define cr(x) (x<<1)+2
    #define mid ((l+r)>>1)
    void init(vector<int> &x){
        n=x.size();
        seg=vector<int> (n*4+5);
        tag=vector<int> (n*4+5);
        a=&x;
    }
    void pull(int id){
        seg[id]=seg[cl(id)]+seg[cr(id)];
    }
    void build(int l,int r,int id=0){
        if(l==r){
            seg[id]=(*a)[l];
            return;
        }
        build(l,mid,cl(id));
        build(mid+1,r,cr(id));
        pull(id);
    }    
    // <單點更新>
    void update(int l,int r,int x,int v,int id=0){
        if(l==r){
            seg[id]=v;
            return;
        }
        if(x<=mid) update(l,mid,x,v,cl(id));
        if(mid<x) update(mid+1,r,x,v,cr(id));
        pull(id);
    }
    //</單點更新>
    // <區間更新>
    void push(int id,int l,int r){
        if(tag[id]){
            seg[id]+=tag[id]*(r-l+1);
            if(l!=r){
                tag[cl(id)]+=tag[id];
                tag[cr(id)]+=tag[id];
            }
            tag[id]=0;
        }
    }
    void update(int l,int r,int sl,int sr,int v,int id=0){
        push(id,l,r);
        if(sl<=l && r<=sr){
            tag[id]+=v;
            return;
        }
        if(sl<=mid) update(l,mid,sl,sr,v,cl(id));
        if(mid<sr) update(mid+1,r,sl,sr,v,cr(id));
        push(cl(id),l,mid);
        push(cr(id),mid+1,r);
        pull(id);
    }
    //</區間更新>
    int qry(int l,int r,int sl,int sr,int id=0){
        push(id,l,r); //區間更新用
        if(sl<=l && r<=sr) return seg[id];
        int ans=0;
        if(sl<=mid) ans+=qry(l,mid,sl,sr,cl(id));
        if(mid<sr) ans+=qry(mid+1,r,sl,sr,cr(id));
        return ans;
}};